# 带内容指纹的构建产物（Hugo fingerprint：/css/main.<hash>.css、/js/**/<name>.<hash>.js）长期缓存。
# Pages 只放静态文件（会话检查在主站鉴权网关），_headers 对这些静态资源生效。
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
# 字体文件名不带指纹，缓存一周
/fonts/*
  Cache-Control: public, max-age=604800
