{
  "name": "styrigx-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sloan Gray 的个人博客（blog.styrigx.com）：Hugo + Tailwind 4，和主站 styrigx-space 同栈，中英双语。",
  "author": "Sloan Gray",
  "homepage": "https://blog.styrigx.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/styrigx/styrigx-blog.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "node scripts/build-css.mjs && hugo --minify --cleanDestinationDir -s web",
    "dev": "node scripts/build-css.mjs --no-minify && hugo server -s web",
    "shell:sync": "node scripts/sync-shell.mjs",
    "shell:check": "node scripts/sync-shell.mjs --check",
    "code-tokens": "node scripts/gen-code-tokens.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config=playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
