---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';
import '../styles/one-ui.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image = '/og.png' } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>

<!-- 自托管字体：public/fonts/LXGWWenKai-Regular.woff2（正文）+ *-ui-subset.woff2（界面），由主题按 site.toml 的 [config.fonts] 生成 @font-face -->
<style>
@font-face{font-family:"Monaco";src:url("/fonts/Monaco.woff2") format("woff2");font-style:normal;font-weight:400;font-display:swap;}
</style>
