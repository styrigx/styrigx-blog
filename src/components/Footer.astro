---
import { getSiteConfig } from '../data/site';
import type { PageLang } from '../utils/lang';

interface Props {
  lang?: PageLang;
}

const { lang = 'zh' } = Astro.props;
const { profile } = await getSiteConfig();
const year = new Date().getFullYear();
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<footer class="oui-footer">
  <p class="copyright">&copy; 2020-{year} Sloan Gray</p>
  <p class="license-note">
    {
      lang === 'en' ? (
        <>
          Articles licensed under{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noreferrer">
            CC BY-NC-SA 4.0
          </a>
        </>
      ) : (
        <>
          文章采用{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noreferrer">
            CC BY-NC-SA 4.0
          </a>{' '}
          协议
        </>
      )
    }
  </p>
  <div class="social-links">
    <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
        ></path>
      </svg>
    </a>
    <a href="https://x.com/styrigx" target="_blank" rel="noreferrer" aria-label="X">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </a>
    <a href={`mailto:${profile.email}`} aria-label="Email">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-10 6L2 7"></path>
      </svg>
    </a>
    <a href={rssHref} aria-label="RSS">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
    </a>
    <a href="https://styrigx.com" target="_blank" rel="noreferrer" aria-label={lang === 'en' ? 'Home' : '主站'}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <path d="M9 22V12h6v10"></path>
      </svg>
    </a>
  </div>
</footer>

<style>
  footer {
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  .copyright {
    margin: 0 0 4px;
  }

  .license-note {
    margin: 0;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.72rem;
  }

  .license-note a {
    color: var(--paper-ink-faint);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .license-note a:hover {
    color: var(--paper-ink);
  }

  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1em;
    margin-top: 1em;
  }

  .social-links a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--paper-ink-soft);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--paper-accent);
  }
</style>
