---
/**
 * 博客跟随主站设置（2026-10-20 起博客没有自己的语言 / 深浅色开关，设置全在主站 styrigx.com/settings/）。
 *
 * 外观 + 语言（is:inline，渲染前同步执行）：读主站写的 sgx-ui cookie（Domain=styrigx.com，base64url JSON），
 * 契约见 docs/sgx-ui-cookie.md。
 * - mode（或别名 theme）：light | dark | system；没有 cookie → 系统 prefers-color-scheme。
 * - pal：调色板 id；accent：强调色（色板 id 或 #rrggbb），缺省跟 pal。
 * - fs / rm：字体大小 / 减弱动效。
 * - lang：zh | en。和当前页语言不同、且本页有对应语言版本（<meta name="sgx-alt-zh|en">）时 location.replace 过去。
 *   没有 cookie 的 lang 时沿用旧行为：只有中文首页按旧的 styrigx-blog-lang / 浏览器语言跳 /en/。
 * 博客原来的主题开关已删除：旧的 navfolio-theme / sgx-theme-at 本地键清掉，避免盖过主站设置。
 * ClientRouter 换页后 <html> 属性会被新页面覆盖，所以 astro:after-swap 再应用一次。
 *
 * 数字健康：文章页记 post:<slug>（标题取 h1，3 分钟没操作才停表），其他页记 blog，
 * 上报到主站 https://styrigx.com/api/wellbeing。
 */
interface Props {
  /** 本页的中文 / 英文版本地址（只在真的有对应版本时传），用于按 cookie 的 lang 跳转。 */
  alt?: { zh?: string; en?: string };
}
const { alt = {} } = Astro.props;
---

{alt.zh && <meta name="sgx-alt-zh" content={alt.zh} />}
{alt.en && <meta name="sgx-alt-en" content={alt.en} />}
<script is:inline>
  (() => {
    const read = () => {
      const m = document.cookie.match(/(?:^|;\s*)sgx-ui=([^;]*)/);
      if (!m || !m[1]) return null;
      try {
        let b = m[1].replace(/-/g, '+').replace(/_/g, '/');
        while (b.length % 4) b += '=';
        const v = JSON.parse(decodeURIComponent(escape(atob(b))));
        return v && typeof v === 'object' ? v : null;
      } catch {
        return null;
      }
    };
    const ID = /^[a-z]{2,16}$/;
    const HEX = /^#[0-9a-f]{6}$/i;
    /* #rrggbb 强调色上的文字：按相对亮度选白字或深字 */
    const onColor = (hex) => {
      const n = (i) => {
        const c = parseInt(hex.slice(i, i + 2), 16) / 255;
        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      };
      const L = 0.2126 * n(1) + 0.7152 * n(3) + 0.0722 * n(5);
      return L > 0.4 ? '#161b20' : '#ffffff';
    };
    const lang = () => {
      const l = (document.documentElement.getAttribute('lang') || '').toLowerCase();
      return l.startsWith('en') ? 'en' : 'zh';
    };
    const isBot = () =>
      /bot|crawl|spider|slurp|mediapartners|baidu|bingpreview|facebookexternalhit|twitterbot|linkedinbot|embedly|quora|pinterest|slackbot|discordbot|telegrambot|whatsapp|applebot|duckduckbot|yandex|sogou|exabot|semrush|ahrefs/i.test(
        navigator.userAgent || '',
      );
    /* 语言：返回要跳去的地址，不跳返回 '' */
    const langTarget = (ui) => {
      let want = ui && (ui.lang === 'zh' || ui.lang === 'en') ? ui.lang : '';
      const path = location.pathname;
      if (!want) {
        /* 旧行为：只在中文首页按本地记忆 / 浏览器语言跳英文 */
        if (path !== '/') return '';
        let stored = null;
        try {
          stored = localStorage.getItem('styrigx-blog-lang');
        } catch {}
        if (stored === 'zh') return '';
        const nav = (navigator.language || '').toLowerCase();
        if (stored === 'en' || nav === 'en' || nav.startsWith('en-')) want = 'en';
        else return '';
      }
      if (want === lang()) return '';
      const meta = document.querySelector('meta[name="sgx-alt-' + want + '"]');
      const href = meta && meta.getAttribute('content');
      if (!href || href === path) return '';
      return href + location.hash;
    };
    const apply = () => {
      try {
        const ui = read();
        const root = document.documentElement;
        try {
          localStorage.removeItem('navfolio-theme');
          localStorage.removeItem('sgx-theme-at');
        } catch {}
        if (!isBot()) {
          const go = langTarget(ui);
          if (go) {
            location.replace(go);
            return;
          }
        }
        const mode = ui && (ui.mode || ui.theme);
        const sys = !!window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        const dark = mode === 'dark' || (mode !== 'light' && sys);
        root.dataset.theme = dark ? 'dark' : 'light';
        root.style.colorScheme = dark ? 'dark' : 'light';
        const pal = ui && typeof ui.pal === 'string' && ID.test(ui.pal) ? ui.pal : 'lake';
        if (pal !== 'lake') root.setAttribute('data-palette', pal);
        else root.removeAttribute('data-palette');
        const acc = ui && typeof ui.accent === 'string' ? ui.accent : '';
        if (root.style.removeProperty) {
          root.style.removeProperty('--sgx-accent');
          root.style.removeProperty('--sgx-on-accent');
        }
        if (ID.test(acc)) {
          root.setAttribute('data-accent', acc);
        } else {
          root.removeAttribute('data-accent');
          if (HEX.test(acc) && root.style.setProperty) {
            root.style.setProperty('--sgx-accent', acc);
            root.style.setProperty('--sgx-on-accent', onColor(acc));
          }
        }
        const fs = ui && (ui.fs === 'small' || ui.fs === 'large') ? ui.fs : '';
        root.style.fontSize = fs === 'large' ? '112.5%' : fs === 'small' ? '87.5%' : '';
        root.classList.toggle('reduced-motion', !!(ui && ui.rm === 1));
      } catch {}
    };
    apply();
    if (!window.__sgxInheritInit) {
      window.__sgxInheritInit = true;
      document.addEventListener('astro:after-swap', apply);
      /* 跟系统：系统深浅色变了再应用一次（cookie 指定了 light/dark 时 apply 会保持原样） */
      try {
        window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener('change', apply);
      } catch {}
    }
  })();
</script>

<script>
  import { initWbTrack } from '../scripts/sgx/wb-track.js';

  const ENDPOINT = 'https://styrigx.com/api/wellbeing';
  let cur: { stop: () => void; flush: () => void } | null = null;

  function start() {
    if (cur) {
      cur.flush();
      cur.stop();
      cur = null;
    }
    const p = location.pathname.replace(/^\/en(?=\/)/, '');
    const m = p.match(/^\/post\/([A-Za-z0-9_\-.%]{1,80})\/?$/);
    if (m) {
      cur = initWbTrack({
        key: 'post:' + m[1],
        title: () =>
          (document.querySelector('main h1')?.textContent || document.title || '').trim(),
        endpoint: ENDPOINT,
        idleMs: 180000,
      });
    } else {
      cur = initWbTrack({ key: 'blog', endpoint: ENDPOINT });
    }
  }
  document.addEventListener('astro:page-load', start);
</script>
