---
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import BlogTopNav from './BlogTopNav.astro';
import { getSiteConfig } from '../../data/site';
import { getAllCategories, getAllSeries, getAllTags } from '../../utils/content-groups';
import { sortByDateDesc } from '../../utils/content-dates';
import { getHtmlLangFor, getUiTextFor } from '../../utils/ui-text';
import { pageLangOf, postSlugFromId, postUrl, type PageLang } from '../../utils/lang';
import { slugifyGroupName } from '../../utils/content-groups';

// 博客唯一的列表页（= 博客首页），沉浸式 app：顶栏分段滑块 首页 · 文章 · 专题 切换三个面板（src/scripts/app-tabs.ts）。
// 首页：标题区（与 Book .subpage-head 同规格）+ 最新 3 篇 + 最新的系列卡。
// 文章：全部文章列表。专题：系列 → 分类 → 标签，点分类 / 标签就地筛出文章。
interface Props {
  lang: PageLang;
}
const { lang } = Astro.props;
const isEn = lang === 'en';
const siteConfig = await getSiteConfig();
const { site, pages } = siteConfig;
const htmlLang = getHtmlLangFor(lang);
const ui = getUiTextFor(lang);
const pageMeta = pages.blog;
const posts = sortByDateDesc(
  await getCollection('blog', ({ data }) => !data.draft && pageLangOf(data) === lang),
);
const pageTitle = isEn ? 'Blog' : '博客';
const pageNote = isEn ? (pageMeta.note ?? '') : pageMeta.note;
const latest = posts.slice(0, 3);
const series = getAllSeries(posts);
const newestSeries = series[0];
const categories = getAllCategories(posts).filter((c) => c.slug !== 'uncategorized');
const tags = getAllTags(posts);

function formatDate(date: Date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function postHref(post: (typeof posts)[number]) {
  return postUrl(lang, postSlugFromId(post.id));
}

const slugs = (names: string[] = []) => names.map((n) => slugifyGroupName(n)).join(' ');

const t = {
  latest: isEn ? 'Latest' : '最新',
  allPosts: isEn ? 'All posts' : '全部文章',
  viewAll: isEn ? 'All posts' : '全部文章',
  series: isEn ? 'Series' : '系列',
  categories: isEn ? 'Categories' : '分类',
  tags: isEn ? 'Tags' : '标签',
  count: (n: number) => (isEn ? `${n} ${n === 1 ? 'post' : 'posts'}` : `${n} 篇`),
  part: (n: number) => (isEn ? `Part ${n}` : `第 ${n} 篇`),
  clear: isEn ? 'Clear' : '清除',
  newestSeries: isEn ? 'Series' : '系列',
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead
      title={`${pageTitle} | ${site.title}`}
      description={pageNote || site.pageDescription}
      alt={{ zh: '/', en: '/en/' }}
    />
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 0 var(--layout-page-gutter) var(--layout-page-bottom);
      }

      /* 面板：横向排成一行，按 --pane-pos 平移；不活动的面板平时高度 0（页面高度只跟当前面板），
         切换 / 拖动时（is-moving）临时展开，让相邻面板跟着滑进来 */
      /* 左右各伸出 18px（= 列表区左右留白），卡片阴影不被 overflow 裁掉 */
      .sgx-panes {
        margin: 0 -18px;
        overflow: hidden;
        touch-action: pan-y;
      }

      .sgx-panes.is-dragging {
        user-select: none;
        -webkit-user-select: none;
      }

      .sgx-panes-track {
        display: flex;
        align-items: flex-start;
        transform: translateX(calc(var(--pane-pos, 0) * -100%));
        transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
      }

      .sgx-panes.is-dragging .sgx-panes-track {
        transition: none;
      }

      :global(.reduced-motion) .sgx-panes-track {
        transition: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .sgx-panes-track {
          transition: none;
        }
      }

      .sgx-pane {
        flex: 0 0 100%;
        min-width: 0;
        padding: calc(92px + env(safe-area-inset-top, 0px)) 18px 8px;
      }

      .sgx-pane:not(.is-active) {
        height: 0;
        overflow: hidden;
      }

      .sgx-panes.is-moving .sgx-pane {
        height: auto;
        overflow: visible;
      }

      /* 首页面板的标题区自带顶栏留白 */
      .sgx-pane[data-pane='home'] {
        padding-top: 0;
      }

      .note-entry.is-compact {
        grid-template-columns: minmax(0, 1fr);
        padding: 18px 0;
      }

      /* 标题区：与 Book .subpage-head / .subpage-title 同规格 */
      .sgx-subpage-head {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        text-align: center;
        min-height: max(280px, 35svh);
        padding: calc(84px + env(safe-area-inset-top, 0px)) 20px 76px;
      }

      .sgx-subpage-title {
        margin: 0;
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--m-primary, var(--paper-accent));
      }

      .sgx-sec-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 6px;
        padding: 0 2px;
      }

      .sgx-sec-title {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--m-on-surface-variant);
      }

      .sgx-sec-more {
        border: 0;
        padding: 6px 2px;
        background: none;
        color: var(--m-primary);
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .sgx-sec + .sgx-sec {
        margin-top: 34px;
      }

      .notes-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .note-entry {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 16px;
        padding: 26px 0;
        border-bottom: 1px solid var(--m-outline);
      }

      .note-entry[hidden] {
        display: none;
      }

      .note-num {
        color: var(--m-on-surface-variant);
        font-family: var(--font-meta);
        font-size: 0.8rem;
        font-weight: 700;
        padding-top: 4px;
      }

      .note-body {
        min-width: 0;
      }

      .note-title {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.4;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .note-title a {
        color: var(--m-on-surface);
        text-decoration: none;
      }

      .note-title a:hover {
        color: var(--m-primary);
      }

      .note-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        align-items: center;
        margin-top: 10px;
        color: var(--m-on-surface-variant);
        font-family: var(--font-meta);
        font-size: 0.78rem;
        font-weight: 700;
      }

      .note-meta a {
        color: var(--m-primary);
        text-decoration: none;
      }

      .note-desc {
        margin: 10px 0 0;
        color: var(--m-on-surface-variant);
        font-size: 0.92rem;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* 首页「最新」：卡片 */
      .latest-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .latest-card {
        display: block;
        padding: 16px 18px;
        border-radius: var(--oui-radius-card, 24px);
        background: var(--m-container-lowest);
        box-shadow: var(--oui-shadow-card);
        color: var(--m-on-surface);
        text-decoration: none;
      }

      .latest-card strong {
        display: block;
        font-size: 1.02rem;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }

      .latest-card time {
        display: block;
        margin-top: 6px;
        color: var(--m-on-surface-variant);
        font-family: var(--font-meta);
        font-size: 0.76rem;
        font-weight: 700;
      }

      /* 系列卡 */
      .series-card {
        padding: 18px;
        border-radius: var(--oui-radius-card, 24px);
        background: var(--m-container-lowest);
        box-shadow: var(--oui-shadow-card);
        transition: box-shadow 0.2s ease;
      }

      .series-card.is-target {
        box-shadow:
          0 0 0 2px var(--sgx-accent),
          var(--oui-shadow-card);
      }

      .series-card + .series-card {
        margin-top: 12px;
      }

      .series-card-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
      }

      .series-card-name {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--m-on-surface);
      }

      .series-card-count {
        flex-shrink: 0;
        color: var(--m-on-surface-variant);
        font-family: var(--font-meta);
        font-size: 0.76rem;
        font-weight: 700;
      }

      .series-card ol {
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        counter-reset: s;
      }

      .series-card li {
        display: grid;
        grid-template-columns: 26px minmax(0, 1fr);
        gap: 8px;
        align-items: baseline;
        padding: 7px 0;
      }

      .series-card li + li {
        border-top: 1px solid var(--m-outline);
      }

      .series-card li span {
        color: var(--m-primary);
        font-family: var(--font-meta);
        font-size: 0.78rem;
        font-weight: 800;
      }

      .series-card li a {
        color: var(--m-on-surface);
        font-size: 0.95rem;
        line-height: 1.45;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .series-card li a:hover {
        color: var(--m-primary);
      }

      /* 专题筛选芯片（原列表页标签墙搬到这里） */
      .chip-wall {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 15px;
        border: 0;
        border-radius: 15px;
        background: var(--m-container-lowest);
        box-shadow: var(--oui-shadow-card);
        color: var(--m-on-surface);
        font: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
      }

      .chip .count {
        opacity: 0.7;
        font-weight: 400;
      }

      .chip[aria-pressed='true'] {
        background: var(--sgx-accent);
        color: var(--sgx-on-accent);
      }

      .chip:focus-visible,
      .sgx-sec-more:focus-visible {
        outline: 2px solid var(--sgx-accent);
        outline-offset: 2px;
      }

      .topic-results {
        margin-bottom: 34px;
        scroll-margin-top: calc(92px + env(safe-area-inset-top, 0px));
      }

      .topic-results[hidden] {
        display: none;
      }

      .empty-note {
        margin: 0;
        padding: 40px 0;
        color: var(--m-on-surface-variant);
        line-height: 1.75;
      }

      @media (max-width: 720px) {
        .note-entry {
          grid-template-columns: 32px minmax(0, 1fr);
          gap: 10px;
          padding: 20px 0;
        }

        .note-title {
          font-size: 1.1rem;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav lang={lang} mode="tabs" />
    <main class="oui-archive-wrap">
      <div class="sgx-panes" data-sgx-panes data-tab="home">
        <div class="sgx-panes-track" data-sgx-track>
          <section
            class="sgx-pane is-active"
            id="sgx-pane-home"
            role="tabpanel"
            aria-labelledby="sgx-tab-home"
            data-pane="home"
          >
            <header class="sgx-subpage-head">
              <h1 class="sgx-subpage-title">{pageTitle}</h1>
            </header>

            {
              latest.length > 0 ? (
                <section class="sgx-sec" aria-labelledby="sgx-latest-title">
                  <div class="sgx-sec-head">
                    <h2 class="sgx-sec-title" id="sgx-latest-title">
                      {t.latest}
                    </h2>
                    <button type="button" class="sgx-sec-more" data-sgx-goto="posts">
                      {t.viewAll} →
                    </button>
                  </div>
                  <ul class="latest-list">
                    {latest.map((post) => (
                      <li>
                        <a class="latest-card" href={postHref(post)}>
                          <strong>{post.data.title}</strong>
                          <time datetime={post.data.date.toISOString()}>
                            {formatDate(post.data.date)}
                          </time>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ) : (
                <p class="empty-note">{ui.groups.emptyArchives}</p>
              )
            }

            {
              newestSeries && (
                <section class="sgx-sec" aria-labelledby="sgx-home-series-title">
                  <div class="sgx-sec-head">
                    <h2 class="sgx-sec-title" id="sgx-home-series-title">
                      {t.newestSeries}
                    </h2>
                    <button type="button" class="sgx-sec-more" data-sgx-goto="topics">
                      {isEn ? 'Topics' : '专题'} →
                    </button>
                  </div>
                  <article class="series-card">
                    <div class="series-card-head">
                      <h3 class="series-card-name">{newestSeries.name}</h3>
                      <span class="series-card-count">{t.count(newestSeries.count)}</span>
                    </div>
                    <ol>
                      {newestSeries.posts.map((post, i) => (
                        <li>
                          <span>{String(i + 1).padStart(2, '0')}</span>
                          <a href={postHref(post)}>{post.data.title}</a>
                        </li>
                      ))}
                    </ol>
                  </article>
                </section>
              )
            }
          </section>

          <section
            class="sgx-pane"
            id="sgx-pane-posts"
            role="tabpanel"
            aria-labelledby="sgx-tab-posts"
            data-pane="posts"
            inert
          >
            <div class="sgx-sec-head">
              <h2 class="sgx-sec-title">{t.allPosts} · {t.count(posts.length)}</h2>
            </div>
            {
              posts.length > 0 ? (
                <ol class="notes-list">
                  {posts.map((post, i) => (
                    <li class="note-entry">
                      <span class="note-num">{String(i + 1).padStart(2, '0')}</span>
                      <div class="note-body">
                        <h3 class="note-title">
                          <a href={postHref(post)}>{post.data.title}</a>
                        </h3>
                        <div class="note-meta">
                          <time datetime={post.data.date.toISOString()}>
                            {formatDate(post.data.date)}
                          </time>
                          {post.data.tags.slice(0, 4).map((tag) => (
                            <a href={`#topics/tag/${encodeURIComponent(slugifyGroupName(tag))}`}>
                              #{tag}
                            </a>
                          ))}
                        </div>
                        {post.data.description && <p class="note-desc">{post.data.description}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="empty-note">{ui.groups.emptyArchives}</p>
              )
            }
          </section>

          <section
            class="sgx-pane"
            id="sgx-pane-topics"
            role="tabpanel"
            aria-labelledby="sgx-tab-topics"
            data-pane="topics"
            inert
          >
            <section class="topic-results sgx-sec" data-topic-results hidden aria-live="polite">
              <div class="sgx-sec-head">
                <h2 class="sgx-sec-title" data-topic-results-title></h2>
                <button type="button" class="sgx-sec-more" data-topic-clear>{t.clear}</button>
              </div>
              <ol class="notes-list">
                {
                  posts.map((post) => (
                    <li
                      class="note-entry is-compact"
                      data-topic-post
                      data-tags={slugs(post.data.tags)}
                      data-cats={slugs(post.data.categories)}
                      hidden
                    >
                      <div class="note-body">
                        <h3 class="note-title">
                          <a href={postHref(post)}>{post.data.title}</a>
                        </h3>
                        <div class="note-meta">
                          <time datetime={post.data.date.toISOString()}>
                            {formatDate(post.data.date)}
                          </time>
                        </div>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </section>

            {
              series.length > 0 && (
                <section class="sgx-sec" aria-labelledby="sgx-series-title">
                  <div class="sgx-sec-head">
                    <h2 class="sgx-sec-title" id="sgx-series-title">
                      {t.series}
                    </h2>
                  </div>
                  {series.map((s) => (
                    <article class="series-card" data-series-card={s.slug} id={`series-${s.slug}`}>
                      <div class="series-card-head">
                        <h3 class="series-card-name">{s.name}</h3>
                        <span class="series-card-count">{t.count(s.count)}</span>
                      </div>
                      <ol>
                        {s.posts.map((post, i) => (
                          <li>
                            <span>{String(i + 1).padStart(2, '0')}</span>
                            <a href={postHref(post)}>{post.data.title}</a>
                          </li>
                        ))}
                      </ol>
                    </article>
                  ))}
                </section>
              )
            }

            {
              categories.length > 0 && (
                <section class="sgx-sec" aria-labelledby="sgx-cats-title">
                  <div class="sgx-sec-head">
                    <h2 class="sgx-sec-title" id="sgx-cats-title">
                      {t.categories}
                    </h2>
                  </div>
                  <div class="chip-wall">
                    {categories.map((c) => (
                      <button
                        type="button"
                        class="chip"
                        aria-pressed="false"
                        data-topic-filter={`category:${c.slug}`}
                        data-label={c.name}
                      >
                        {c.name} <span class="count">{c.count}</span>
                      </button>
                    ))}
                  </div>
                </section>
              )
            }

            {
              tags.length > 0 && (
                <section class="sgx-sec" aria-labelledby="sgx-tags-title">
                  <div class="sgx-sec-head">
                    <h2 class="sgx-sec-title" id="sgx-tags-title">
                      {t.tags}
                    </h2>
                  </div>
                  <div class="chip-wall">
                    {tags.map((tag) => (
                      <button
                        type="button"
                        class="chip"
                        aria-pressed="false"
                        data-topic-filter={`tag:${tag.slug}`}
                        data-label={`#${tag.name}`}
                      >
                        {tag.name} <span class="count">{tag.count}</span>
                      </button>
                    ))}
                  </div>
                </section>
              )
            }
          </section>
        </div>
      </div>
    </main>
    <Footer lang={lang} />
    <script>
      import { initAppTabs } from '../../scripts/app-tabs';

      document.addEventListener('astro:page-load', initAppTabs);
      initAppTabs();
    </script>
  </body>
</html>
