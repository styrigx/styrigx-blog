---
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import BlogTopNav from './BlogTopNav.astro';
import { getSiteConfig } from '../../data/site';
import { slugifyGroupName } from '../../utils/content-groups';
import { sortByDateDesc } from '../../utils/content-dates';
import { getHtmlLangFor, getUiTextFor } from '../../utils/ui-text';
import { pageLangOf, postSlugFromId, postUrl, tagUrl, type PageLang } from '../../utils/lang';

// 博客唯一的列表页（= 博客首页）。2026-10 简化：删掉原首页（Styrigx 大字 + 最近文章卡），
// / 直接是文章列表；标题区与 Book 的 .subpage-head 同规格（居中、主题色大字、下方内容区），
// 让主站 / 书库 / 博客 切换时看起来是同一套网站。
interface Props {
  lang: PageLang;
}
const { lang } = Astro.props;
const isEn = lang === 'en';
const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const palette = theme.palette;
const htmlLang = getHtmlLangFor(lang);
const ui = getUiTextFor(lang);
const pageMeta = pages.blog;
const posts = sortByDateDesc(
  await getCollection('blog', ({ data }) => !data.draft && pageLangOf(data) === lang),
);
const pageTitle = isEn ? 'Blog' : '博客';
const pageNote = isEn ? (pageMeta.note ?? '') : pageMeta.note;

// Collect all tags for filter pills
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

function formatDate(date: Date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function postHref(post: (typeof posts)[number]) {
  return postUrl(lang, postSlugFromId(post.id));
}

function postTagHref(tag: string) {
  return tagUrl(lang, slugifyGroupName(tag));
}
---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead
      title={`${pageTitle} | ${site.title}`}
      description={pageNote || site.pageDescription}
    />
    {/* 只有中文首页做语言跳转；/en/ 也用这个组件，不能再跳 /en/，否则英文浏览器会无限 reload */}
    {!isEn && (
      <script is:inline>
        (() => {
          try {
            const KEY = 'styrigx-blog-lang';
            const ua = navigator.userAgent || '';
            const isBot =
              /bot|crawl|spider|slurp|mediapartners|baidu|bingpreview|facebookexternalhit|twitterbot|linkedinbot|embedly|quora|pinterest|slackbot|discordbot|telegrambot|whatsapp|applebot|duckduckbot|yandex|sogou|exabot|semrush|ahrefs/i.test(
                ua,
              );
            if (isBot) return;
            const stored = localStorage.getItem(KEY);
            if (stored === 'en') {
              location.replace('/en/');
              return;
            }
            if (stored === 'zh') return;
            const navLang = (navigator.language || '').toLowerCase();
            if (navLang === 'en' || navLang.startsWith('en-')) {
              location.replace('/en/');
            }
          } catch {}
        })();
      </script>
    )}
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 0 var(--layout-page-gutter) var(--layout-page-bottom);
      }

      /* 标题区：与 Book .subpage-head / .subpage-title 同规格 */
      .sgx-subpage-head {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        text-align: center;
        min-height: max(280px, 35svh);
        padding: calc(84px + env(safe-area-inset-top, 0px)) 20px 76px;
      }

      .sgx-subpage-title {
        margin: 0;
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--m-primary, var(--paper-accent));
      }

      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        padding: 18px 0 8px;
        border-bottom: 1px solid var(--paper-line);
      }

      .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        border: 1px solid var(--paper-line);
        border-radius: 999px;
        color: var(--paper-ink-soft);
        font-family: var(--font-meta);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        transition:
          border-color 0.15s,
          color 0.15s;
      }

      .filter-pill:hover {
        border-color: var(--paper-accent);
        color: var(--paper-ink);
      }

      .filter-pill.active {
        border-color: var(--paper-ink);
        color: var(--paper-ink);
      }

      .filter-pill .count {
        color: var(--paper-ink-faint);
        font-weight: 400;
      }

      .filter-links {
        margin-left: auto;
        display: flex;
        gap: 14px;
        font-family: var(--font-meta);
        font-size: 0.78rem;
        font-weight: 700;
      }

      .filter-links a {
        color: var(--paper-ink-faint);
        text-decoration: none;
      }

      .filter-links a:hover {
        color: var(--paper-ink);
      }

      .notes-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .note-entry {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 16px;
        padding: 26px 0;
        border-bottom: 1px solid var(--paper-line);
      }

      .note-num {
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
        font-size: 0.8rem;
        font-weight: 700;
        padding-top: 4px;
      }

      .note-body {
        min-width: 0;
      }

      .note-title-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .note-title {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.4;
        font-weight: 700;
      }

      .note-title a {
        color: var(--paper-ink);
        text-decoration: none;
      }

      .note-title a:hover {
        color: var(--paper-accent);
      }

      .pinned-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border: 1px solid var(--paper-line);
        border-radius: 6px;
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
        font-size: 0.7rem;
        font-weight: 700;
      }

      .note-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        align-items: center;
        margin-top: 10px;
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
        font-size: 0.78rem;
        font-weight: 700;
      }

      .note-meta a {
        color: var(--paper-accent);
        text-decoration: none;
      }

      .note-meta a:hover {
        color: var(--paper-ink);
      }

      .note-desc {
        margin: 10px 0 0;
        color: var(--paper-ink-soft);
        font-size: 0.92rem;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .empty-note {
        max-width: 620px;
        margin: 0;
        padding: 40px 0;
        color: var(--paper-ink-soft);
        font-size: 1rem;
        line-height: 1.75;
      }

      @media (max-width: 720px) {
        .note-entry {
          grid-template-columns: 32px minmax(0, 1fr);
          gap: 10px;
          padding: 20px 0;
        }

        .note-title {
          font-size: 1.1rem;
        }

        .filter-links {
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav lang={lang} zhHref="/" enHref="/en/" />
    <main data-pagefind-body class="oui-archive-wrap">
      <header class="sgx-subpage-head">
        <h1 class="sgx-subpage-title">{pageTitle}</h1>
      </header>

      <div class="filter-bar">
        <span class="filter-pill active">
          <span>●</span>
          {isEn ? 'All articles' : '全部文章'}
          <span class="count">{posts.length}</span>
        </span>
        {
          allTags.slice(0, 6).map(([tag, count]) => (
            <a class="filter-pill" href={postTagHref(tag)}>
              {tag} <span class="count">{count}</span>
            </a>
          ))
        }
        <span class="filter-links">
          <a href={isEn ? '/en/tags/' : '/tags/'}>{isEn ? 'Tags' : '标签'}</a>
        </span>
      </div>

      {
        posts.length > 0 ? (
          <ol class="notes-list">
            {posts.map((post, i) => (
              <li class="note-entry">
                <span class="note-num">{String(i + 1).padStart(2, '0')}</span>
                <div class="note-body">
                  <div class="note-title-row">
                    <h2 class="note-title">
                      <a href={postHref(post)}>{post.data.title}</a>
                    </h2>
                  </div>
                  <div class="note-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    {post.data.tags.slice(0, 4).map((tag) => (
                      <a href={postTagHref(tag)}>#{tag}</a>
                    ))}
                  </div>
                  {post.data.description && <p class="note-desc">{post.data.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-note">{ui.groups.emptyArchives}</p>
        )
      }
    </main>
    <Footer lang={lang} />
  </body>
</html>
