---
// 顶栏 v4「沉浸式 app」（2026-10-20）：左圆九宫格 · 中间长条 · 右圆头像。没有 ‹ 返回、没有 ⋮（语言 / 深浅色在主站设置里）。
// - 九宫格：Gmail 式左侧导航抽屉，和主站 styrigx-space 同一套（主页 / 书签 / 书库 / 博客 + 底部 设置）；博客是当前项。
// - 长条（mode）：
//   tabs    列表页：分段滑块 首页 · 文章 · 专题，强调色指示器滑到当前页签；面板切换见 src/scripts/app-tabs.ts。
//   links   标签页 / 404 等子页：同样的分段滑块，但每项是回列表页对应页签的链接（404 不高亮）。
//   article 文章页：同 links，「文章」高亮；长条底边一条强调色细线是阅读进度（长条里不放标题）。
// - 抽屉底部：文章页（≥2 个标题）是「目录」（h2 + 缩进 h3，当前节强调色，点了收起抽屉再滚过去）；
//   其他页没有底部区，也没有「设置」入口。
// - 右圆头像只展示（以后接账号体系），不可点击、不导航。
import { countTocItems, type TocItem } from '../../utils/toc-tree';
import { localizedPath, type PageLang } from '../../utils/lang';
import TocTree from './TocTree.astro';

export type AppTab = 'home' | 'posts' | 'topics';

interface Props {
  lang?: PageLang;
  mode?: 'tabs' | 'links' | 'article';
  /** links 模式下高亮的页签；不传（如 404）就不高亮 */
  activeTab?: AppTab;
  /** article 模式：目录（少于 2 项不显示） */
  tocItems?: TocItem[];
}

const { lang = 'zh', mode = 'links', activeTab, tocItems = [] } = Astro.props;
const isEn = lang === 'en';
const homeHref = localizedPath(lang, '/');
/* 头像由主站统一管理（设置页可换），这里直接读主站 /avatar/；右圆 52px 用 192 档（与主站一致） */
const avatarSrc = 'https://styrigx.com/avatar/192.webp';

const TABS: { id: AppTab; zh: string; en: string }[] = [
  { id: 'home', zh: '首页', en: 'Home' },
  { id: 'posts', zh: '文章', en: 'Posts' },
  { id: 'topics', zh: '专题', en: 'Topics' },
];
const tabHref = (id: AppTab) => (id === 'home' ? homeHref : `${homeHref}#${id}`);

/* 导航抽屉：与主站 baseof.html #sgx-drawer 同顺序、同图标；书库 / 主站是外站，博客是当前项 */
const main = isEn ? 'https://styrigx.com/en/' : 'https://styrigx.com/';
const drawerItems = [
  { id: 'home', zh: '主页', en: 'Home', href: main, icon: 'home' },
  { id: 'bookmarks', zh: '书签', en: 'Bookmarks', href: `${main}bookmarks/`, icon: 'bookmark' },
  {
    id: 'book',
    zh: '书库',
    en: 'Library',
    href: isEn ? 'https://book.styrigx.com/en/' : 'https://book.styrigx.com/',
    icon: 'book',
  },
  { id: 'blog', zh: '博客', en: 'Blog', href: homeHref, icon: 'blog', current: true },
];
/* 文章页「文章」高亮；links 页按传入的 activeTab；没有就 null（不高亮） */
const linkTab: AppTab | null = mode === 'article' ? 'posts' : (activeTab ?? null);

const hasToc = mode === 'article' && countTocItems(tocItems) >= 2;
const t = {
  nav: isEn ? 'Navigation' : '导航',
  tabs: isEn ? 'Blog sections' : '博客分区',
  toc: isEn ? 'Contents' : '目录',
  progress: isEn ? 'Reading progress' : '阅读进度',
};
---

<header class="sgx-site-nav" data-sgx-topbar-root data-mode={mode}>
  <div class="sgx-topbar">
    <button
      type="button"
      class="sgx-tb-nav"
      data-sgx-apps
      aria-label={t.nav}
      aria-haspopup="dialog"
      aria-controls="sgx-drawer"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><circle cx="5" cy="5" r="2"></circle><circle cx="12" cy="5" r="2"></circle><circle
          cx="19"
          cy="5"
          r="2"></circle><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"
        ></circle><circle cx="19" cy="12" r="2"></circle><circle cx="5" cy="19" r="2"
        ></circle><circle cx="12" cy="19" r="2"></circle><circle cx="19" cy="19" r="2"
        ></circle></svg
      >
    </button>

    <div class:list={['sgx-tb-pill', `sgx-tb-pill--${mode}`]}>
      {
        mode === 'tabs' ? (
          <div class="sgx-seg" role="tablist" aria-label={t.tabs} data-sgx-seg style="--seg-pos:0">
            <span class="sgx-seg-ind" aria-hidden="true" />
            {TABS.map((tab, i) => (
              <button
                type="button"
                role="tab"
                class="sgx-seg-btn"
                id={`sgx-tab-${tab.id}`}
                aria-controls={`sgx-pane-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-sgx-tab={tab.id}
              >
                {isEn ? tab.en : tab.zh}
              </button>
            ))}
          </div>
        ) : (
          <nav
            class:list={['sgx-seg', { 'sgx-seg--none': linkTab === null }]}
            aria-label={t.tabs}
            style={`--seg-pos:${linkTab === null ? 0 : TABS.findIndex((x) => x.id === linkTab)}`}
          >
            <span class="sgx-seg-ind" aria-hidden="true" />
            {TABS.map((tab) => (
              <a
                class="sgx-seg-btn"
                href={tabHref(tab.id)}
                aria-current={tab.id === linkTab ? 'page' : undefined}
              >
                {isEn ? tab.en : tab.zh}
              </a>
            ))}
          </nav>
        )
      }
      {
        mode === 'article' && (
          <span
            class="sgx-tb-progress"
            role="progressbar"
            aria-label={t.progress}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-sgx-progress
          />
        )
      }
    </div>

    <span class="sgx-tb-me" aria-hidden="true">
      <img class="sgx-tb-avatar" src={avatarSrc} alt="" width="52" height="52" />
    </span>
  </div>

  <dialog id="sgx-drawer" class="sgx-drawer" aria-label={t.nav} data-sgx-sheet="drawer">
    <nav class="sgx-drawer-sheet" data-sgx-sheet-panel>
      <p class="sgx-drawer-head">Styrigx</p>
      <ul class="sgx-drawer-list">
        {
          drawerItems.map((it) => (
            <li>
              <a
                class="sgx-drawer-item"
                href={it.href}
                data-nav={it.id}
                aria-current={it.current ? 'page' : undefined}
              >
                <span class="sgx-drawer-ic">
                  {it.icon === 'home' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3.5 10.5L12 3.5l8.5 7" />
                      <path d="M5.5 9v11h4.5v-6h4v6h4.5V9" />
                    </svg>
                  )}
                  {it.icon === 'bookmark' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-4.2-6.5 4.2v-16a1 1 0 0 1 1-1z" />
                    </svg>
                  )}
                  {it.icon === 'book' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M12 6.5C10 4.9 7 4.2 3.5 4.2v13.6c3.5 0 6.5.7 8.5 2.3 2-1.6 5-2.3 8.5-2.3V4.2C17 4.2 14 4.9 12 6.5z" />
                      <path d="M12 6.5v13.6" />
                    </svg>
                  )}
                  {it.icon === 'blog' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 20h4.2L19.4 8.8a2 2 0 0 0 0-2.8l-1.4-1.4a2 2 0 0 0-2.8 0L4 15.8z" />
                      <path d="M13.5 6.5l4 4" />
                    </svg>
                  )}
                </span>
                <span class="sgx-drawer-label">{isEn ? it.en : it.zh}</span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        hasToc && (
          <section class="sgx-drawer-toc" aria-labelledby="sgx-drawer-toc-title" data-toc-root>
            <hr class="sgx-drawer-div" />
            <p id="sgx-drawer-toc-title" class="sgx-drawer-sub">
              {t.toc}
            </p>
            <TocTree items={tocItems} idPrefix="drawer-toc" navLink />
          </section>
        )
      }
    </nav>
  </dialog>
</header>

<script>
  import { initSheet } from '../../scripts/sgx-sheet';
  import { mountNavfolioTocSpy } from '../../utils/toc-spy';

  /** 文章阅读进度：#article-start（正文）从顶栏下沿开始读，到正文底部离开视口底部为 100%；画在长条底边。 */
  let ticking = false;
  function updateProgress() {
    ticking = false;
    const bar = document.querySelector<HTMLElement>('[data-sgx-progress]');
    const body =
      document.querySelector<HTMLElement>('#article-start') || document.querySelector('main');
    if (!bar || !body) return;
    const r = body.getBoundingClientRect();
    const start = window.scrollY + r.top - 80;
    const end = window.scrollY + r.bottom - window.innerHeight;
    const span = Math.max(1, end - start);
    const p = Math.min(1, Math.max(0, (window.scrollY - start) / span));
    bar.style.setProperty('--p', p.toFixed(4));
    bar.setAttribute('aria-valuenow', String(Math.round(p * 100)));
  }
  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateProgress);
    }
  }

  function initTopbar() {
    const r = document.querySelector<HTMLElement>('[data-sgx-topbar-root]');
    if (!r || r.dataset.sgxReady === 'true') return;
    r.dataset.sgxReady = 'true';

    const drawerBtn = r.querySelector<HTMLElement>('[data-sgx-apps]');
    const drawer = r.querySelector<HTMLDialogElement>('#sgx-drawer');
    if (drawerBtn && drawer) {
      const sheet = initSheet(drawer, drawerBtn);
      /* 捕获阶段处理，先于目录 spy 挂在链接上的点击：先收起抽屉（关掉模态后页面才能滚），再滚到标题 */
      drawer.addEventListener(
        'click',
        (e) => {
          const me = e as MouseEvent;
          if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
          const t = e.target as Element;
          const toc = t.closest?.<HTMLAnchorElement>('a[data-toc-link]');
          if (toc) {
            e.preventDefault();
            e.stopPropagation();
            sheet.close(true);
            const id = decodeURIComponent((toc.getAttribute('href') || '').replace(/^#/, ''));
            const el = id ? document.getElementById(id) : null;
            if (el) {
              const reduce =
                document.documentElement.classList.contains('reduced-motion') ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
              history.replaceState(history.state, '', `#${encodeURIComponent(id)}`);
            }
            return;
          }
          /* 抽屉项：当前项（博客）只关闭；其他项先收起再跳转 */
          const a = t.closest?.<HTMLAnchorElement>('a.sgx-drawer-item');
          if (!a) return;
          e.preventDefault();
          e.stopPropagation();
          sheet.close();
          if (a.getAttribute('aria-current') !== 'page') location.assign(a.href);
        },
        true,
      );
      /* 目录分支全部展开（抽屉里一眼看全）；当前节高亮交给 toc-spy */
      for (const li of drawer.querySelectorAll<HTMLElement>('[data-toc-expanded]'))
        li.dataset.tocExpanded = 'true';
      for (const b of drawer.querySelectorAll<HTMLElement>('[data-toc-toggle]'))
        b.setAttribute('aria-expanded', 'true');
      if (drawer.querySelector('[data-toc-root]')) mountNavfolioTocSpy();
    }

    updateProgress();
  }

  const w = window as unknown as { __sgxTopbarGlobal?: boolean };
  if (!w.__sgxTopbarGlobal) {
    w.__sgxTopbarGlobal = true;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('pageshow', onScroll);
    document.addEventListener('astro:page-load', initTopbar);
  }
  initTopbar();
</script>

<style is:global>
  /* ===== 顶栏 v4（与主站 Space 同款三块：九宫格 · 长条 · 头像）===== */
  .sgx-topbar {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top, 0px));
    left: 16px;
    right: 16px;
    height: 52px;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  @media (min-width: 980px) {
    .sgx-topbar {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: min(calc(100vw - 32px), 1068px);
    }
  }

  .sgx-tb-pill,
  .sgx-tb-nav {
    background: color-mix(
      in srgb,
      color-mix(in srgb, var(--m-primary) 10%, var(--m-surface)) 88%,
      transparent
    );
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    pointer-events: auto;
  }

  :root[data-theme='dark'] .sgx-tb-pill,
  :root[data-theme='dark'] .sgx-tb-nav,
  :root[data-theme='dark'] .sgx-tb-me {
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sgx-tb-pill,
    .sgx-tb-nav {
      background: color-mix(in srgb, var(--m-primary) 10%, var(--m-surface));
    }
  }

  .sgx-tb-nav {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--m-on-surface);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .sgx-tb-nav svg {
    width: 22px;
    height: 22px;
  }

  .sgx-tb-pill {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 52px;
    border-radius: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
  }

  /* 右圆：头像，只展示（以后接账号体系），不可点击 */
  .sgx-tb-me {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    flex-shrink: 0;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    pointer-events: auto;
    cursor: default;
    user-select: none;
  }

  .sgx-tb-me .sgx-tb-avatar {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 999px;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
  }

  /* ===== 分段滑块（首页 · 文章 · 专题）：强调色指示器按 --seg-pos（0..2，可为小数，跟手）平移 ===== */
  .sgx-seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 360px;
    height: 40px;
    margin: 0 auto;
  }

  .sgx-seg-ind {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / 3);
    height: 100%;
    border-radius: 20px;
    background: var(--sgx-accent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--sgx-accent) 35%, transparent);
    transform: translateX(calc(var(--seg-pos, 0) * 100%));
    transition: transform 0.28s cubic-bezier(0.2, 0, 0, 1);
    pointer-events: none;
  }

  .sgx-seg.is-dragging .sgx-seg-ind {
    transition: none;
  }

  .sgx-seg-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 40px;
    padding: 0 6px;
    border: 0;
    border-radius: 20px;
    background: transparent;
    color: var(--m-on-surface-variant);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s ease;
  }

  .sgx-seg-btn[aria-selected='true'],
  .sgx-seg-btn[aria-current='page'] {
    color: var(--sgx-on-accent);
    font-weight: 700;
  }

  .sgx-seg-btn:focus-visible {
    outline: 2px solid var(--sgx-accent);
    outline-offset: 2px;
  }

  /* ===== 文章页：长条底边一条强调色细线 = 阅读进度（长条 overflow 不裁，细线自己按圆角收进去）===== */
  .sgx-tb-progress {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 1px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--sgx-accent) 16%, transparent);
    overflow: hidden;
    pointer-events: none;
  }

  .sgx-tb-progress::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--sgx-accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left center;
  }

  /* 没有高亮页签（404）：指示器不显示 */
  .sgx-seg--none .sgx-seg-ind {
    display: none;
  }

  .sgx-tb-nav:focus-visible {
    outline: 2px solid var(--m-primary);
    outline-offset: 2px;
  }

  .sgx-tb-nav:active {
    background-color: rgba(0, 0, 0, 0.06);
  }

  :root[data-theme='dark'] .sgx-tb-nav:active {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* ===== 导航抽屉（与主站 input.css .sgx-drawer 同规格）：<dialog> 模态，::backdrop 遮罩，面板从左滑入 ===== */
  .sgx-drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: var(--m-on-surface);
  }

  .sgx-drawer::backdrop {
    background: rgba(0, 0, 0, 0);
    transition: background-color 0.22s ease;
  }

  .sgx-drawer.is-open::backdrop {
    background: rgba(0, 0, 0, 0.32);
  }

  .sgx-drawer-sheet {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(85vw, 320px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--m-container-lowest);
    border-radius: 0 1.75rem 1.75rem 0;
    box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.3);
    padding: calc(16px + env(safe-area-inset-top, 0px)) 12px
      calc(16px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-104%);
    transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1);
  }

  .sgx-drawer.is-open .sgx-drawer-sheet {
    transform: none;
  }

  .sgx-drawer-head {
    margin: 0;
    padding: 14px 16px 18px;
    font-size: 20px;
    font-weight: 700;
    color: var(--m-on-surface);
  }

  .sgx-drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sgx-drawer-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 20px 0 16px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: var(--m-on-surface-variant);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .sgx-drawer-item:hover {
    background: var(--m-container);
  }

  .sgx-drawer-item:active {
    background: var(--m-container-high);
  }

  .sgx-drawer-item:focus-visible {
    outline: 2px solid var(--m-primary);
    outline-offset: -2px;
  }

  /* 当前项：强调色药丸（与滑块指示器同色） */
  .sgx-drawer-item[aria-current='page'],
  .sgx-drawer-item[aria-current='page']:hover {
    background: var(--sgx-accent);
    color: var(--sgx-on-accent);
    font-weight: 700;
  }

  .sgx-drawer-ic {
    width: 24px;
    height: 24px;
