---
// 顶栏 v4「沉浸式 app」（2026-10-20）：左圆九宫格 · 中间长条 · 右圆头像。没有 ‹ 返回、没有 ⋮（语言 / 深浅色在主站设置里）。
// - 九宫格：Gmail 式左侧导航抽屉，和主站 styrigx-space 同一套（主页 / 书签 / 书库 / 博客 + 底部 设置）；博客是当前项。
// - 长条（mode）：
//   tabs    列表页：分段滑块 首页 · 文章 · 专题，强调色指示器滑到当前页签；面板切换见 src/scripts/app-tabs.ts。
//   links   标签页等子页：同样的分段滑块，但每项是回列表页对应页签的链接。
//   article 文章页：阅读进度条 + 文章标题，点开是目录底部弹层（标题来自正文 h2/h3）。
//   brand   其他（404）：居中 Styrigx。
// - 右圆头像只展示（以后接账号体系），不可点击、不导航。
import { getSiteConfig } from '../../data/site';
import { localizedPath, type PageLang } from '../../utils/lang';
import { getUiTextFor } from '../../utils/ui-text';
import TocTree from './TocTree.astro';
import type { TocItem } from '../../utils/toc-tree';

export type AppTab = 'home' | 'posts' | 'topics';

interface Props {
  lang?: PageLang;
  mode?: 'tabs' | 'links' | 'article' | 'brand';
  /** links 模式下高亮的页签 */
  activeTab?: AppTab;
  /** article 模式：文章标题 */
  title?: string;
  /** article 模式：目录 */
  tocItems?: TocItem[];
}

const { lang = 'zh', mode = 'brand', activeTab = 'home', title = '', tocItems = [] } = Astro.props;
const { site } = await getSiteConfig();
const ui = getUiTextFor(lang);
const isEn = lang === 'en';
const homeHref = localizedPath(lang, '/');
/* 头像由主站统一管理（设置页可换），这里直接读主站 /avatar/；右圆 52px 用 192 档（与主站一致） */
const avatarSrc = 'https://styrigx.com/avatar/192.webp';

const TABS: { id: AppTab; zh: string; en: string }[] = [
  { id: 'home', zh: '首页', en: 'Home' },
  { id: 'posts', zh: '文章', en: 'Posts' },
  { id: 'topics', zh: '专题', en: 'Topics' },
];
const tabHref = (id: AppTab) => (id === 'home' ? homeHref : `${homeHref}#${id}`);

/* 导航抽屉：与主站 baseof.html #sgx-drawer 同顺序、同图标；书库 / 主站是外站，博客是当前项 */
const main = isEn ? 'https://styrigx.com/en/' : 'https://styrigx.com/';
const drawerItems = [
  { id: 'home', zh: '主页', en: 'Home', href: main, icon: 'home' },
  { id: 'bookmarks', zh: '书签', en: 'Bookmarks', href: `${main}bookmarks/`, icon: 'bookmark' },
  {
    id: 'book',
    zh: '书库',
    en: 'Library',
    href: isEn ? 'https://book.styrigx.com/en/' : 'https://book.styrigx.com/',
    icon: 'book',
  },
  { id: 'blog', zh: '博客', en: 'Blog', href: homeHref, icon: 'blog', current: true },
];
const settingsHref = `${main}settings/`;

const hasToc = mode === 'article' && tocItems.length > 0;
const t = {
  nav: isEn ? 'Navigation' : '导航',
  tabs: isEn ? 'Blog sections' : '博客分区',
  settings: isEn ? 'Settings' : '设置',
  toc: ui.toc.title,
  progress: isEn ? 'Reading progress' : '阅读进度',
  openToc: isEn ? 'Open table of contents' : '打开目录',
  close: isEn ? 'Close' : '关闭',
};
---

<header class="sgx-site-nav" data-sgx-topbar-root data-mode={mode}>
  <div class="sgx-topbar">
    <button
      type="button"
      class="sgx-tb-nav"
      data-sgx-apps
      aria-label={t.nav}
      aria-haspopup="dialog"
      aria-controls="sgx-drawer"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><circle cx="5" cy="5" r="2"></circle><circle cx="12" cy="5" r="2"></circle><circle
          cx="19"
          cy="5"
          r="2"></circle><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"
        ></circle><circle cx="19" cy="12" r="2"></circle><circle cx="5" cy="19" r="2"
        ></circle><circle cx="12" cy="19" r="2"></circle><circle cx="19" cy="19" r="2"
        ></circle></svg
      >
    </button>

    <div class:list={['sgx-tb-pill', `sgx-tb-pill--${mode}`]}>
      {
        mode === 'tabs' && (
          <div class="sgx-seg" role="tablist" aria-label={t.tabs} data-sgx-seg style="--seg-pos:0">
            <span class="sgx-seg-ind" aria-hidden="true" />
            {TABS.map((tab, i) => (
              <button
                type="button"
                role="tab"
                class="sgx-seg-btn"
                id={`sgx-tab-${tab.id}`}
                aria-controls={`sgx-pane-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-sgx-tab={tab.id}
              >
                {isEn ? tab.en : tab.zh}
              </button>
            ))}
          </div>
        )
      }
      {
        mode === 'links' && (
          <nav
            class="sgx-seg"
            aria-label={t.tabs}
            style={`--seg-pos:${TABS.findIndex((x) => x.id === activeTab)}`}
          >
            <span class="sgx-seg-ind" aria-hidden="true" />
            {TABS.map((tab) => (
              <a
                class="sgx-seg-btn"
                href={tabHref(tab.id)}
                aria-current={tab.id === activeTab ? 'page' : undefined}
              >
                {isEn ? tab.en : tab.zh}
              </a>
            ))}
          </nav>
        )
      }
      {
        mode === 'article' &&
          (hasToc ? (
            <button
              type="button"
              class="sgx-tb-progress"
              data-sgx-progress
              aria-haspopup="dialog"
              aria-controls="sgx-toc-sheet"
              aria-expanded="false"
              aria-label={`${t.openToc}：${title}`}
            >
              <span
                class="sgx-prog-fill"
                role="progressbar"
                aria-label={t.progress}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-sgx-progress-fill
              />
              <span class="sgx-prog-title">{title}</span>
              <svg
                class="sgx-prog-ic"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M8 6h12M8 12h12M8 18h12" />
                <circle cx="4" cy="6" r="1" fill="currentColor" />
                <circle cx="4" cy="12" r="1" fill="currentColor" />
                <circle cx="4" cy="18" r="1" fill="currentColor" />
              </svg>
            </button>
          ) : (
            <div class="sgx-tb-progress" data-sgx-progress>
              <span
                class="sgx-prog-fill"
                role="progressbar"
                aria-label={t.progress}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-sgx-progress-fill
              />
              <span class="sgx-prog-title">{title}</span>
            </div>
          ))
      }
      {
        mode === 'brand' && (
          <a class="sgx-tb-brand" href={homeHref} aria-label={site.title}>
            <span class="sgx-tb-text">{site.title}</span>
          </a>
        )
      }
    </div>

    <span class="sgx-tb-me" aria-hidden="true">
      <img class="sgx-tb-avatar" src={avatarSrc} alt="" width="52" height="52" />
    </span>
  </div>

  <dialog id="sgx-drawer" class="sgx-drawer" aria-label={t.nav} data-sgx-sheet="drawer">
    <nav class="sgx-drawer-sheet" data-sgx-sheet-panel>
      <p class="sgx-drawer-head">Styrigx</p>
      <ul class="sgx-drawer-list">
        {
          drawerItems.map((it) => (
            <li>
              <a
                class="sgx-drawer-item"
                href={it.href}
                data-nav={it.id}
                aria-current={it.current ? 'page' : undefined}
              >
                <span class="sgx-drawer-ic">
                  {it.icon === 'home' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3.5 10.5L12 3.5l8.5 7" />
                      <path d="M5.5 9v11h4.5v-6h4v6h4.5V9" />
                    </svg>
                  )}
                  {it.icon === 'bookmark' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-4.2-6.5 4.2v-16a1 1 0 0 1 1-1z" />
                    </svg>
                  )}
                  {it.icon === 'book' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M12 6.5C10 4.9 7 4.2 3.5 4.2v13.6c3.5 0 6.5.7 8.5 2.3 2-1.6 5-2.3 8.5-2.3V4.2C17 4.2 14 4.9 12 6.5z" />
                      <path d="M12 6.5v13.6" />
                    </svg>
                  )}
                  {it.icon === 'blog' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 20h4.2L19.4 8.8a2 2 0 0 0 0-2.8l-1.4-1.4a2 2 0 0 0-2.8 0L4 15.8z" />
                      <path d="M13.5 6.5l4 4" />
                    </svg>
                  )}
                </span>
                <span class="sgx-drawer-label">{isEn ? it.en : it.zh}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <hr class="sgx-drawer-div" />
      <ul class="sgx-drawer-list">
        <li>
          <a class="sgx-drawer-item" href={settingsHref} data-nav="settings">
            <span class="sgx-drawer-ic">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.431.99l1.004.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"
                ></path>
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </span>
            <span class="sgx-drawer-label">{t.settings}</span>
          </a>
        </li>
      </ul>
    </nav>
  </dialog>

  {
    hasToc && (
      <dialog
        id="sgx-toc-sheet"
        class="sgx-bsheet"
        aria-labelledby="sgx-toc-title"
        data-sgx-sheet="toc"
      >
        <div class="sgx-bsheet-panel" data-sgx-sheet-panel data-toc-root>
          <span class="sgx-bsheet-handle" aria-hidden="true" />
          <div class="sgx-bsheet-head">
            <p id="sgx-toc-title">{t.toc}</p>
            <button
              type="button"
              class="sgx-bsheet-close"
              data-sgx-sheet-close
              aria-label={t.close}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>
          <div class="sgx-bsheet-body">
            <TocTree items={tocItems} idPrefix="sheet-toc" navLink />
          </div>
        </div>
      </dialog>
    )
  }
</header>

<script>
  import { initSheet } from '../../scripts/sgx-sheet';

  /** 文章阅读进度：#article-start（正文）从顶栏下沿开始读，到正文底部离开视口底部为 100%。 */
  let ticking = false;
  function updateProgress() {
    ticking = false;
    const fill = document.querySelector<HTMLElement>('[data-sgx-progress-fill]');
    const bar = document.querySelector<HTMLElement>('[data-sgx-progress]');
    const body =
      document.querySelector<HTMLElement>('#article-start') || document.querySelector('main');
    if (!fill || !bar || !body) return;
    const r = body.getBoundingClientRect();
    const start = window.scrollY + r.top - 80;
    const end = window.scrollY + r.bottom - window.innerHeight;
    const span = Math.max(1, end - start);
    const p = Math.min(1, Math.max(0, (window.scrollY - start) / span));
    bar.style.setProperty('--p', p.toFixed(4));
    fill.setAttribute('aria-valuenow', String(Math.round(p * 100)));
  }
  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateProgress);
    }
  }

  function initTopbar() {
    const r = document.querySelector<HTMLElement>('[data-sgx-topbar-root]');
    if (!r || r.dataset.sgxReady === 'true') return;
    r.dataset.sgxReady = 'true';

    const drawerBtn = r.querySelector<HTMLElement>('[data-sgx-apps]');
    const drawer = r.querySelector<HTMLDialogElement>('#sgx-drawer');
    if (drawerBtn && drawer) {
      const sheet = initSheet(drawer, drawerBtn);
      /* 抽屉项：当前项（博客）只关闭；其他项先收起再跳转 */
      drawer.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.<HTMLAnchorElement>('a.sgx-drawer-item');
        if (!a) return;
        const me = e as MouseEvent;
        if (
          e.defaultPrevented ||
          me.button !== 0 ||
          me.metaKey ||
          me.ctrlKey ||
          me.shiftKey ||
          me.altKey
        )
          return;
        e.preventDefault();
        e.stopPropagation();
        sheet.close();
        if (a.getAttribute('aria-current') !== 'page') location.assign(a.href);
      });
    }

    const progBtn = r.querySelector<HTMLElement>('button[data-sgx-progress]');
    const toc = r.querySelector<HTMLDialogElement>('#sgx-toc-sheet');
    if (progBtn && toc) {
      const sheet = initSheet(toc, progBtn);
      toc.addEventListener('click', (e) => {
        const t = e.target as Element;
        if (t.closest?.('[data-sgx-sheet-close]')) {
          sheet.close();
          return;
        }
        const link = t.closest?.<HTMLAnchorElement>('a[data-toc-link]');
        if (!link) return;
        /* 先关弹层（关掉模态后页面才能滚），再滚到标题 */
        e.preventDefault();
        sheet.close(true);
        const id = decodeURIComponent((link.getAttribute('href') || '').replace(/^#/, ''));
        const el = id ? document.getElementById(id) : null;
        if (el) {
          const reduce =
            document.documentElement.classList.contains('reduced-motion') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          history.replaceState(history.state, '', `#${encodeURIComponent(id)}`);
        }
      });
      /* 目录分支默认展开，弹层里一眼看全 */
      for (const li of toc.querySelectorAll<HTMLElement>('[data-toc-expanded]'))
        li.dataset.tocExpanded = 'true';
      for (const b of toc.querySelectorAll<HTMLElement>('[data-toc-toggle]'))
        b.setAttribute('aria-expanded', 'true');
    }

    updateProgress();
  }

  const w = window as unknown as { __sgxTopbarGlobal?: boolean };
  if (!w.__sgxTopbarGlobal) {
    w.__sgxTopbarGlobal = true;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('pageshow', onScroll);
    document.addEventListener('astro:page-load', initTopbar);
  }
  initTopbar();
</script>

<style is:global>
  /* ===== 顶栏 v4（与主站 Space 同款三块：九宫格 · 长条 · 头像）===== */
  .sgx-topbar {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top, 0px));
    left: 16px;
    right: 16px;
    height: 52px;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  @media (min-width: 980px) {
    .sgx-topbar {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: min(calc(100vw - 32px), 1068px);
    }
  }

  .sgx-tb-pill,
  .sgx-tb-nav {
    background: color-mix(
      in srgb,
      color-mix(in srgb, var(--m-primary) 10%, var(--m-surface)) 88%,
      transparent
    );
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    pointer-events: auto;
  }

  :root[data-theme='dark'] .sgx-tb-pill,
  :root[data-theme='dark'] .sgx-tb-nav,
  :root[data-theme='dark'] .sgx-tb-me {
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sgx-tb-pill,
    .sgx-tb-nav {
      background: color-mix(in srgb, var(--m-primary) 10%, var(--m-surface));
    }
  }

  .sgx-tb-nav {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--m-on-surface);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .sgx-tb-nav svg {
    width: 22px;
    height: 22px;
  }

  .sgx-tb-pill {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 52px;
    border-radius: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
  }

  .sgx-tb-brand {
    display: inline-flex;
    align-items: center;
    height: 40px;
    border-radius: 20px;
    color: var(--m-on-surface);
    text-decoration: none;
  }

  .sgx-tb-text {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    color: var(--m-on-surface);
    white-space: nowrap;
  }

  /* 右圆：头像，只展示（以后接账号体系），不可点击 */
  .sgx-tb-me {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    flex-shrink: 0;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    pointer-events: auto;
    cursor: default;
    user-select: none;
  }

  .sgx-tb-me .sgx-tb-avatar {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 999px;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
  }

  /* ===== 分段滑块（首页 · 文章 · 专题）：强调色指示器按 --seg-pos（0..2，可为小数，跟手）平移 ===== */
  .sgx-seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 360px;
    height: 40px;
    margin: 0 auto;
  }

  .sgx-seg-ind {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / 3);
    height: 100%;
    border-radius: 20px;
    background: var(--sgx-accent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--sgx-accent) 35%, transparent);
    transform: translateX(calc(var(--seg-pos, 0) * 100%));
    transition: transform 0.28s cubic-bezier(0.2, 0, 0, 1);
    pointer-events: none;
  }

  .sgx-seg.is-dragging .sgx-seg-ind {
    transition: none;
  }

  .sgx-seg-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 40px;
