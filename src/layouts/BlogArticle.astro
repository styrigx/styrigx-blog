---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import BaseHead from '../components/BaseHead.astro';
import CommentSection from '../components/comments/CommentSection.astro';
import MermaidRenderer from '@navfolio/mdx-components/MermaidRenderer.astro';
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';
import { getThemePalette, getSiteConfig } from '../data/site';
import { resolveCommentsConfig, supportsCommentSection } from '../utils/comments';
import { sortByDateDesc } from '../utils/content-dates';
import { getSeriesContext, slugifyGroupName } from '../utils/content-groups';
import { buildTocTree, countTocItems } from '../utils/toc-tree';
import { getUiTextFor } from '../utils/ui-text';
import { pageLangOf, postSlugFromId, postUrl, type PageLang } from '../utils/lang';
import ShareButtons from '../components/blog/ShareButtons.astro';
import Footer from '../components/Footer.astro';
import '@navfolio/theme-default/styles/blog-article.css';

const siteConfig = await getSiteConfig();
const { comments: rawComments } = siteConfig;
const comments = resolveCommentsConfig(rawComments);

type SidebarConfig = {
  enable?: boolean;
  toc?: boolean;
  relatedPosts?: boolean;
};

interface Props {
  post?: {
    id: string;
    collection?: string;
    body?: string;
    data: {
      title: string;
      description: string;
      date: Date;
      heroImage?: ImageMetadata | string;
      showHeroImage?: boolean;
      tags?: string[];
      categories?: string[];
      series?: string[];
      comments?: boolean;
      draft?: boolean;
      lang?: string;
      sidebar?: SidebarConfig;
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
  sidebar?: SidebarConfig;
  headerVariant?: 'default' | 'archive';
  headerKicker?: string;
  headerNote?: string;
  title?: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  tags?: string[];
  categories?: string[];
  series?: string[];
  contentFont?: 'article' | 'ui';
  /** Page language. Defaults to the post frontmatter lang. */
  lang?: PageLang;
  /** URL of this page (or its translation) in the other language. */
  translationHref?: string;
}

const props = Astro.props;
const palette = await getThemePalette();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const headings = props.headings ?? [];
const post = props.post ?? {
  id: 'standalone',
  collection: 'standalone',
  body: props.description ?? '',
  data: {
    title: props.title ?? 'Untitled',
    description: props.description ?? '',
    date: props.date ?? new Date(),
    heroImage: props.heroImage,
    showHeroImage: props.showHeroImage ?? true,
    tags: props.tags ?? [],
    categories: props.categories ?? [],
    series: props.series ?? [],
    draft: false,
    sidebar: { enable: true, toc: true, relatedPosts: true },
  },
};
const isBlogPost = post.collection === 'blog';
const shouldMountCommentSection = supportsCommentSection(post.collection);
const { title, description, date, heroImage, showHeroImage = true } = post.data;
const contentFont = props.contentFont ?? 'article';
const bodyText = 'body' in post && typeof post.body === 'string' ? post.body : description;
const englishWords = bodyText.match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*/g) ?? [];
const cjkChars =
  bodyText.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/gu) ?? [];
const lang: PageLang = props.lang ?? pageLangOf(post.data);
const ui = getUiTextFor(lang);
const wordCount = englishWords.length + cjkChars.length;
const readingMinutes = Math.max(1, Math.ceil(englishWords.length / 220 + cjkChars.length / 500));
const readingTime = ui.article.readingTime(readingMinutes);
const tags = post.data.tags ?? [];
const tagLinks = tags.map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const categoryLinks = (post.data.categories ?? []).map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const rawSeries = post.data.series ?? [];
const tocItems = buildTocTree(headings);
const tocItemCount = countTocItems(tocItems);
const sidebarConfig = {
  enable: true,
  toc: true,
  relatedPosts: true,
  ...post.data.sidebar,
  ...props.sidebar,
};
const shouldRenderSidebar = sidebarConfig.enable ?? true;
const shouldRenderToc = sidebarConfig.toc ?? true;
const hasToc = shouldRenderToc && tocItemCount > 0;

const allBlogPosts = await getCollection(
  'blog',
  ({ data }) => !data.draft && pageLangOf(data) === lang,
);
const currentBlogPost = isBlogPost ? (post as CollectionEntry<'blog'>) : undefined;
const seriesContext = isBlogPost
  ? getSeriesContext(currentBlogPost!, allBlogPosts, rawSeries[0])
  : undefined;
const seriesLinks = rawSeries.map((name) => {
  const isPrimarySeries = seriesContext?.name === name;

  return {
    name,
    slug: slugifyGroupName(name),
    current: isPrimarySeries ? seriesContext.current : undefined,
    total: isPrimarySeries ? seriesContext.total : undefined,
  };
});
const relatedPosts = sortByDateDesc(allBlogPosts.filter(({ id }) => id !== post.id)).slice(0, 3);
const hasRelatedPosts =
  shouldRenderSidebar && (sidebarConfig.relatedPosts ?? true) && relatedPosts.length > 0;
const hasSidebar = shouldRenderSidebar && hasToc;
const currentPathname = Astro.url.pathname;
/* 只有真的有另一语言版本才给 alt：主站 cookie 的 lang 不同时跳过去 */
const altHrefs = props.translationHref
  ? lang === 'zh'
    ? { zh: currentPathname, en: props.translationHref }
    : { zh: props.translationHref, en: currentPathname }
  : undefined;
const listHref = lang === 'en' ? '/en/' : '/';
const shareUrl = new URL(currentPathname, siteConfig.site.url).toString();
---

<!doctype html>
<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead title={title} description={description} alt={altHrefs} />
    {
      comments.provider === 'waline' && comments.enabled && (
        <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
      )
    }
    <style>
      .sgx-series-block {
        margin: 18px 0 16px;
        padding: 12px 14px;
        border-radius: 18px;
        background: var(--m-container-low);
        border: 1px solid var(--m-outline);
        font-family: var(--font-ui, inherit);
      }
      .sgx-series-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
      }
      .sgx-series-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--m-on-surface);
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
      }
      .sgx-series-pos {
        flex-shrink: 0;
        padding: 3px 9px;
        border-radius: 999px;
        background: var(--sgx-accent);
        color: var(--sgx-on-accent);
        font-size: 12px;
        font-weight: 700;
      }
      .sgx-series-nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 10px;
      }
      .sgx-series-nav a {
        display: block;
        min-width: 0;
        padding: 8px 10px;
        border-radius: 12px;
        background: var(--m-container-lowest);
        color: var(--m-on-surface);
        text-decoration: none;
      }
      .sgx-series-nav a.next {
        text-align: right;
      }
      .sgx-series-nav small {
        display: block;
        color: var(--m-on-surface-variant);
        font-size: 11px;
        font-weight: 700;
      }
      .sgx-series-nav span {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
        font-weight: 600;
      }
    </style>
  </head>
  <body class:list={['blog-detail-page', { 'blog-content-ui': contentFont === 'ui' }]}>
    <BlogTopNav mode="article" tocItems={hasToc ? tocItems : []} lang={lang} />
    <div class="blog-background" aria-hidden="true"></div>

    <div class="oui-article-wrap">
      <div class="oui-article-layout">
        <main
          class:list={['blog-layout', 'oui-article-main', { 'blog-layout-centered': !hasSidebar }]}
        >
          <div class="article-column">
            <article class="article-card oui-article-paper">
              <ArticleHeader
                title={title}
                description={description}
                date={date}
                wordCount={wordCount}
                readingTime={readingTime}
                tags={tagLinks}
                categories={categoryLinks}
                series={seriesContext ? [] : seriesLinks}
                heroImage={heroImage}
                showHeroImage={showHeroImage}
                variant={props.headerVariant}
                kicker={props.headerKicker}
                note={props.headerNote}
                pathname={Astro.url.pathname}
                showPageView={isBlogPost}
                lang={lang}
              />

              {
                seriesContext && (
                  <aside
                    class="sgx-series-block"
                    aria-label={ui.article.moreInSeries(seriesContext.name)}
                  >
                    <div class="sgx-series-top">
                      <a
                        class="sgx-series-name"
                        href={`${basePath}${listHref}#topics/series/${seriesContext.slug}`}
                      >
                        {seriesContext.name}
                      </a>
                      <span class="sgx-series-pos">
                        {lang === 'en'
                          ? `Part ${seriesContext.current} of ${seriesContext.total}`
                          : `第 ${seriesContext.current} / ${seriesContext.total} 篇`}
                      </span>
                    </div>
                    {(seriesContext.prev || seriesContext.next) && (
                      <div class="sgx-series-nav">
                        {seriesContext.prev ? (
                          <a
                            class="prev"
                            rel="prev"
                            href={`${basePath}${postUrl(pageLangOf(seriesContext.prev.data), postSlugFromId(seriesContext.prev.id))}`}
                          >
                            <small>{lang === 'en' ? '‹ Previous' : '‹ 上一篇'}</small>
                            <span>{seriesContext.prev.data.title}</span>
                          </a>
                        ) : (
                          <span />
                        )}
                        {seriesContext.next ? (
                          <a
                            class="next"
                            rel="next"
                            href={`${basePath}${postUrl(pageLangOf(seriesContext.next.data), postSlugFromId(seriesContext.next.id))}`}
                          >
                            <small>{lang === 'en' ? 'Next ›' : '下一篇 ›'}</small>
                            <span>{seriesContext.next.data.title}</span>
                          </a>
                        ) : (
                          <span />
                        )}
                      </div>
                    )}
                  </aside>
                )
              }

              <section
                id="article-start"
                class:list={['article-content', { 'article-content-ui': contentFont === 'ui' }]}
              >
                <slot />
              </section>
            </article>
            {isBlogPost && <ShareButtons title={title} url={shareUrl} lang={lang} />}
            {
              hasRelatedPosts && (
                <RelatedPosts posts={relatedPosts} class="article-after-related" lang={lang} />
              )
            }
            {
              shouldMountCommentSection && (
                <CommentSection frontmatter={post.data} pathname={Astro.url.pathname} lang={lang} />
              )
            }
          </div>
        </main>
        {
          hasSidebar && (
            <aside class="right-sidebar oui-toc-card" aria-label={ui.article.readingTools}>
              <div class="right-sidebar-inner">
                {hasToc && <TableOfContents items={tocItems} font={contentFont} lang={lang} />}
              </div>
            </aside>
          )
        }
      </div>
    </div>
    <Footer lang={lang} />
    <ScrollToTopButton />
    <ZoomableImage />
    <MermaidRenderer />
  </body>
</html>
