---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../../../layouts/BlogArticle.astro';
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';
import { pageLangOf, postSlugFromId, postUrl } from '../../../utils/lang';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const zhSlugs = new Set(
    posts.filter((p) => pageLangOf(p.data) === 'zh').map((p) => postSlugFromId(p.id)),
  );

  return posts
    .filter((p) => pageLangOf(p.data) === 'en')
    .map((post) => {
      const slug = postSlugFromId(post.id);

      return {
        params: { slug },
        props: {
          post,
          translationHref: zhSlugs.has(slug) ? postUrl('zh', slug) : undefined,
        },
      };
    });
}

const { post, translationHref } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogArticle post={post} headings={headings} lang="en" translationHref={translationHref}>
  <Content components={{ img: ZoomableImage }} />
</BlogArticle>
