---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import BackLink from '../../../components/blog/BackLink.astro';
import BlogArchiveHeader from '../../../components/blog/BlogArchiveHeader.astro';
import BlogPostList from '../../../components/blog/BlogPostList.astro';
import BlogTopNav from '../../../components/blog/BlogTopNav.astro';
import { getSiteConfig } from '../../../data/site';
import { sortBlogPostsForArchive } from '../../../utils/content-dates';
import { getAllTags } from '../../../utils/content-groups';
import { getHtmlLangFor, getUiTextFor } from '../../../utils/ui-text';
import { pageLangOf, tagUrl } from '../../../utils/lang';

const lang = 'en';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && pageLangOf(data) === 'en');

  return getAllTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: sortBlogPostsForArchive(tag.posts),
    },
  }));
}

const { tag, posts } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, theme } = siteConfig;
const palette = theme.palette;
const htmlLang = getHtmlLangFor(lang);
const ui = getUiTextFor(lang);
---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead
      title={`${ui.groups.tag}: ${tag.name} | ${site.title}`}
      description={ui.groups.tagNote(tag.count)}
    />
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 118px var(--layout-page-gutter) var(--layout-page-bottom);
      }

      .tag-body {
        max-width: 860px;
        margin: 0 auto;
      }

      @media (max-width: 720px) {
        main {
          padding-top: 88px;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav lang="en" zhHref="/" enHref={tagUrl('en', tag.slug)} />
    <main data-pagefind-body class="oui-archive-wrap">
      <div class="tag-body">
        <BackLink href="/en/" label={ui.groups.back} />
        <BlogArchiveHeader
          kicker={ui.groups.tagCloudKicker}
          title={`#${tag.name}`}
          note={ui.groups.tagNote(tag.count)}
        />
        <BlogPostList posts={posts} lang="en" />
      </div>
    </main>
    <Footer lang="en" />
  </body>
</html>
