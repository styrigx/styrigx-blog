---
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<BaseLayout title="404 Not Found" description="这页暂时没有找到，可能已经迁移或还没有写下。">
  <div class="oui-notfound" role="main" aria-labelledby="not-found-title">
    <div>
      <p class="num" aria-hidden="true">404</p>
      <h1 id="not-found-title">这一页不在这里</h1>
      <p>链接可能已经改变，或者它从未存在。你可以回到首页，或搜索想找的内容。</p>
      <div class="oui-action-row">
        <a class="oui-btn-primary" href={withBase('/')}>返回首页</a>
      </div>
    </div>
  </div>
</BaseLayout>
